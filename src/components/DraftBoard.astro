---
import { getCollection } from 'astro:content';
import DraftSlot from '@/components/DraftSlot.astro';
import BrawlerPicker from '@/components/BrawlerPicker.astro';
import MapPicker from '@/components/MapPicker.astro';
import { sortCategories } from '@/lib/mapCategories';
import { withBase } from '@/lib/basePath';

const maps = await getCollection('maps');

// Client-friendly projection of the maps collection: everything the draft
// board needs to resolve a typed map name, show its mode badge, and render
// its "best picks" panel (image, tips, categories with brawler slugs —
// portraits themselves are cloned client-side from the picker's tile index,
// same as every other portrait on this board).
//
// `image`/`gameMode.image` are based here, once, since this same object
// feeds both <MapPicker> below and the maps-data JSON blob src/scripts/
// draftBoard.ts reads at runtime — basing it upstream means neither
// consumer has to know about the site's base path.
const mapsForClient = maps
  .map((m) => ({
    id: m.id,
    name: m.data.name,
    namePt: m.data.namePt,
    image: withBase(m.data.image),
    environment: m.data.environment,
    gameMode: { ...m.data.gameMode, image: withBase(m.data.gameMode.image) },
    tips: m.data.tips,
    categories: sortCategories(m.data.categories),
  }))
  .sort((a, b) => a.namePt.localeCompare(b.namePt));

// Bans render as a compact strip of small slots above each team panel
// (rather than their own big panels) — set this to `false` to hide them
// again; the bansAlly/bansEnemy arrays, ba*/be* hash keys, and rankPicks
// exclude-list wiring in src/scripts/draftBoard.ts all keep working either
// way.
const SHOW_BANS = true;

// The "who picks first" pill toggle. Was hidden per product request, and is
// back on because the 1-2-2-1 turn banner needs it: without a way to say who
// opens, the turn would silently assume "ally" and be wrong in half the
// matches. Turn and toggle go together — one without the other is worse than
// neither (see §11 of the increment-2 spec).
const SHOW_FIRST_PICK_TOGGLE = true;
---

<section class="mx-auto flex max-w-6xl flex-col gap-6 px-4 pb-16">
  <h1 class="title-brawl mt-6 text-center text-3xl sm:text-4xl">Assistente de Draft</h1>

  <!-- Config panel -->
  <div class="panel w-full">
    <div class="panel__body flex flex-col gap-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="chip">Mapa:</span>
        <button
          type="button"
          id="map-picker-open"
          class="input-field min-w-0 flex-1 cursor-pointer items-center justify-between gap-2 text-left"
        >
          <span id="map-picker-label" class="truncate text-brawl-navy-deep/50">Selecionar mapa...</span>
        </button>
        <button
          type="button"
          id="map-picker-clear"
          aria-label="Limpar mapa selecionado"
          class="cursor-pointer rounded-full bg-brawl-navy-deep px-2.5 py-1 text-sm font-black text-white/70 transition hover:text-white"
          hidden
        >
          &times;
        </button>
        <div id="map-mode-badge" class="flex items-center gap-2 rounded-full bg-brawl-navy-deep px-3 py-1.5" hidden>
          <img id="map-mode-icon" src="" alt="" width="20" height="20" />
          <span id="map-mode-name" class="text-sm font-bold"></span>
        </div>
      </div>

      {
        SHOW_FIRST_PICK_TOGGLE && (
          <div class="flex flex-wrap items-center gap-3">
            <span class="chip">Quem escolhe primeiro?</span>
            <button type="button" id="first-pick-ally" class="pill-toggle pill-toggle--ally" aria-pressed="true">
              Nosso Time
            </button>
            <button type="button" id="first-pick-enemy" class="pill-toggle pill-toggle--enemy" aria-pressed="false">
              Time Inimigo
            </button>
          </div>
        )
      }
    </div>
  </div>

  <!-- Teams (each with its own compact ban strip on top, when SHOW_BANS) -->
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="panel border-brawl-blue/40">
      <h2 class="panel__header border-b-2 border-brawl-blue/60 text-brawl-blue">Nosso Time</h2>
      <div class="panel__body flex flex-col gap-3">
        {
          SHOW_BANS && (
            <div class="flex items-center justify-center gap-2" aria-label="Banimentos do nosso time">
              {[0, 1, 2].map((i) => <DraftSlot team="ally" kind="ban" index={i} compact />)}
            </div>
          )
        }
        <div class="grid grid-cols-3 gap-3">
          {[0, 1, 2].map((i) => <DraftSlot team="ally" kind="pick" index={i} />)}
        </div>
      </div>
    </div>
    <div class="panel border-brawl-red/40">
      <h2 class="panel__header border-b-2 border-brawl-red/60 text-brawl-red">Time Inimigo</h2>
      <div class="panel__body flex flex-col gap-3">
        {
          SHOW_BANS && (
            <div class="flex items-center justify-center gap-2" aria-label="Banimentos do time inimigo">
              {[0, 1, 2].map((i) => <DraftSlot team="enemy" kind="ban" index={i} compact />)}
            </div>
          )
        }
        <div class="grid grid-cols-3 gap-3">
          {[0, 1, 2].map((i) => <DraftSlot team="enemy" kind="pick" index={i} />)}
        </div>
      </div>
    </div>
  </div>

  <!-- Results: the "Análise de Composição" card (ally / enemy / picks). Its
       third section is a relocation of the old counter-picks panel, not a
       rewrite — #counter-picks-list and #counter-row-template are contract. -->
  <div class="panel w-full">
    <h2 class="panel__header">Análise de Composição</h2>
    <div class="panel__body flex flex-col gap-5">
      <p
        id="turn-banner"
        class="rounded-xl bg-brawl-navy-deep px-3 py-2 text-center text-sm font-bold text-brawl-yellow"
        aria-live="polite"
        hidden
      >
      </p>
      <div class="grid gap-5 sm:grid-cols-2">
        <section class="flex flex-col gap-2" aria-labelledby="analysis-ally-heading">
          <h3 id="analysis-ally-heading" class="text-xs font-extrabold tracking-wide text-brawl-blue uppercase">
            Seu time
          </h3>
          <ul id="analysis-ally-list" class="flex flex-col gap-2" aria-live="polite">
            <li class="text-sm text-white/50">Escolha brawlers para o seu time para ver a análise.</li>
          </ul>
        </section>
        <section class="flex flex-col gap-2" aria-labelledby="analysis-enemy-heading">
          <h3 id="analysis-enemy-heading" class="text-xs font-extrabold tracking-wide text-brawl-red uppercase">
            Time inimigo
          </h3>
          <ul id="analysis-enemy-list" class="flex flex-col gap-2" aria-live="polite">
            <li class="text-sm text-white/50">Escolha brawlers do time inimigo para ver as fraquezas.</li>
          </ul>
        </section>
      </div>
      <!--
        Section 3 swaps identity with the draft phase: duos when two ally slots
        are up at once, safe openings on the first pick, a placeholder while the
        enemy picks, and the counter-picks list otherwise. The three lists are
        siblings toggled by `hidden` from a single point in the renderer;
        #counter-picks-list and #counter-row-template stay contract.
      -->
      <section class="flex flex-col gap-2" aria-labelledby="analysis-picks-heading">
        <h3 id="analysis-picks-heading" class="text-xs font-extrabold tracking-wide text-brawl-yellow uppercase">
          Melhores picks
        </h3>
        <p id="picks-insert-hint" class="text-[11px] text-white/40">
          Clique para adicionar ao seu time; botão direito ou toque longo para o time inimigo. Teclado: Enter no seu
          time, Shift+Enter no time inimigo.
        </p>
        <!-- tabindex="-1" so it can receive focus when a phase change hides
             the list that had it (a <p> is otherwise unfocusable). -->
        <p id="picks-placeholder" class="text-sm text-white/50" aria-live="polite" tabindex="-1" hidden></p>
        <ul id="counter-picks-list" class="flex flex-col gap-3" aria-live="polite" tabindex="-1">
          <li class="text-sm text-white/50">Escolha brawlers do time inimigo para ver sugestões.</li>
        </ul>
        <ul id="combo-picks-list" class="flex flex-col gap-3" aria-live="polite" tabindex="-1" hidden></ul>
        <ul id="opening-picks-list" class="flex flex-col gap-3" aria-live="polite" tabindex="-1" hidden></ul>
      </section>
    </div>
  </div>

  <!-- Map picks: recommended brawlers for the selected map, grouped by category. -->
  <div id="map-picks-panel" class="panel w-full" hidden>
    <h2 id="map-picks-header" class="panel__header"></h2>
    <div class="panel__body flex flex-col gap-4">
      <div class="flex flex-wrap items-center gap-4">
        <img
          id="map-picks-image"
          src=""
          alt=""
          width="96"
          height="96"
          class="h-24 w-24 shrink-0 rounded-xl border-2 border-white/10 object-cover"
        />
        <div class="flex flex-col gap-1.5">
          <p id="map-picks-environment" class="text-sm text-white/60"></p>
          <div id="map-picks-mode-badge" class="flex w-fit items-center gap-2 rounded-full bg-brawl-navy-deep px-3 py-1.5">
            <img id="map-picks-mode-icon" src="" alt="" width="18" height="18" />
            <span id="map-picks-mode-name" class="text-sm font-bold"></span>
          </div>
        </div>
      </div>
      <ul id="map-picks-tips" class="flex flex-col gap-2" aria-label="Dicas do mapa" hidden></ul>
      <p class="text-[11px] text-white/40">
        Clique para adicionar ao seu time; botão direito ou toque longo para o time inimigo. Teclado: Enter no seu
        time, Shift+Enter no time inimigo.
      </p>
      <div id="map-picks-categories" class="flex flex-col gap-4" tabindex="-1"></div>
    </div>
  </div>
</section>

<button type="button" id="clear-draft-floating" class="fab-clear" aria-label="Limpar tudo e começar uma nova partida" hidden>
  Limpar
</button>

<!-- Off-screen live region for the transient "can't insert" feedback
     fired by the counter-picks/map-picks panels below (a duplicate
     brawler, or a fully-drafted side) — kept separate from the two
     aria-live lists above so a no-op doesn't ride along with (or get lost
     inside) their own re-announcements. -->
<p id="draft-insert-feedback" class="sr-only" aria-live="polite"></p>

<!-- Insight row for the analysis card's "Seu time" / "Time inimigo" sections.
     The marker's colour encodes the insight tone; renderAnalysisSection() in
     draftBoard.ts swaps the bg-* class per tone (default here is the 'good'
     one, so a row is never left unstyled). -->
<template id="composition-row-template">
  <li class="flex items-start gap-2 text-sm text-white">
    <span class="composition-row__marker mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brawl-yellow"></span>
    <span class="composition-row__text"></span>
  </li>
</template>

<template id="counter-row-template">
  <li>
    <button
      type="button"
      class="counter-row flex w-full cursor-pointer items-center gap-3 rounded-xl border-0 bg-white/5 p-2 text-left transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brawl-yellow"
      data-slug=""
    >
      <span class="counter-row__portrait w-12 shrink-0 overflow-hidden rounded-full"></span>
      <span class="counter-row__text text-sm text-white"></span>
    </button>
  </li>
</template>

<!-- Duo row: two portraits, so deliberately NOT the counter-row template — that
     one's insert handlers assume exactly one slug per row. No insert action
     here; picking a duo in one click is out of scope for this increment. -->
<template id="combo-row-template">
  <li class="flex items-center gap-3 rounded-xl bg-white/5 p-2">
    <span class="combo-row__portraits flex shrink-0 -space-x-3"></span>
    <span class="combo-row__text text-sm text-white"></span>
  </li>
</template>

<!-- Opening row: one slug per row, so it carries the same insert interaction
     as the counter-picks list. -->
<template id="opening-row-template">
  <li>
    <button
      type="button"
      class="counter-row flex w-full cursor-pointer items-center gap-3 rounded-xl border-0 bg-white/5 p-2 text-left transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brawl-yellow"
      data-slug=""
    >
      <span class="counter-row__portrait w-12 shrink-0 overflow-hidden rounded-full"></span>
      <span class="counter-row__text text-sm text-white"></span>
    </button>
  </li>
</template>

<template id="map-category-template">
  <div>
    <h3 class="map-category__label mb-2 text-xs font-extrabold tracking-wide text-brawl-yellow uppercase"></h3>
    <ul class="flex flex-wrap gap-3" role="list"></ul>
  </div>
</template>

<template id="map-portrait-template">
  <li class="flex w-20 flex-col items-center gap-1 text-center">
    <button
      type="button"
      class="map-portrait__link flex w-full cursor-pointer flex-col items-center gap-1 rounded-lg border-0 bg-transparent p-1 text-center transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brawl-yellow"
      data-slug=""
    >
      <span class="map-portrait__frame w-16 shrink-0 overflow-hidden rounded-full bg-black/20"></span>
      <span class="map-portrait__name w-full truncate text-xs font-semibold text-white"></span>
    </button>
  </li>
</template>

<BrawlerPicker />
<MapPicker maps={mapsForClient} />

<script type="application/json" id="maps-data" is:inline set:html={JSON.stringify(mapsForClient).replace(/</g, '\\u003c')} />

<script>
  import { initDraftBoard } from '@/scripts/draftBoard';
  initDraftBoard();
</script>
