---
// Shared map picker dialog, mirroring BrawlerPicker.astro: one instance on
// the page, native <dialog> for a focus-trapped, Esc-dismissible modal.
interface MapOption {
  id: string;
  name: string;
  namePt: string;
  image: string;
}

interface Props {
  maps: MapOption[];
}

const { maps } = Astro.props;
---

<dialog id="map-picker" class="modal">
  <div class="panel__header flex items-center justify-between gap-2">
    <h2 id="map-picker-title" class="text-sm font-extrabold tracking-wide uppercase">Selecionar mapa</h2>
    <button
      type="button"
      id="map-picker-close"
      aria-label="Fechar seleção de mapa"
      class="cursor-pointer rounded-full px-2 py-0.5 text-lg leading-none font-black text-white/70 hover:bg-white/10 hover:text-white"
    >
      &times;
    </button>
  </div>
  <div class="panel__body max-h-[75vh] overflow-y-auto">
    <input
      type="search"
      id="map-picker-search"
      placeholder="Buscar mapa..."
      aria-label="Buscar mapa"
      autocomplete="off"
      class="input-field mb-3"
    />
    <p id="map-picker-empty" class="py-6 text-center text-sm text-white/60" hidden>Nenhum mapa encontrado.</p>
    <ul id="map-picker-grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4" role="list">
      {
        maps.map((m) => (
          <li>
            <button type="button" class="map-picker-tile" data-map-id={m.id} data-search={`${m.name} ${m.namePt}`.toLowerCase()} aria-pressed="false">
              <img src={m.image} alt={m.namePt} width="150" height="150" loading="lazy" decoding="async" />
              <span class="text-xs font-semibold text-white">{m.namePt}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>
