---
import { withBase } from '@/lib/basePath';

const navItems = [
  { href: withBase('/'), label: 'Draft' },
  { href: withBase('/brawlers/'), label: 'Brawlers' },
  { href: withBase('/mapas/'), label: 'Mapas' },
];

const homeHref = withBase('/');
const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === homeHref) return currentPath === homeHref;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-10 border-b border-white/10 bg-brawl-navy-deep/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={homeHref} class="flex items-center gap-2 text-lg font-black tracking-tight text-brawl-purple">
      <img src={withBase('/logo.png')} alt="" width="32" height="32" class="h-8 w-8" />
      Braw<span class="text-white">Draft</span>
    </a>
    <nav aria-label="Navegação principal">
      <ul class="flex gap-2 text-sm font-bold">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="block rounded-full px-3 py-1.5 text-white/80 transition hover:bg-white/10 hover:text-white aria-[current=page]:bg-brawl-purple aria-[current=page]:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
