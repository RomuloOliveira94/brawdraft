---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const maps = (await getCollection('maps')).sort((a, b) => a.data.namePt.localeCompare(b.data.namePt));
---

<BaseLayout title="Mapas — BrawDraft" description="Todos os mapas de Brawl Stars, com modo de jogo e dicas de composição.">
  <section class="mx-auto flex max-w-6xl flex-col gap-6 px-4 pt-6 pb-16">
    <h1 class="title-brawl text-center text-3xl sm:text-4xl">Mapas</h1>
    <p class="text-center text-white/70">{maps.length} mapas no total.</p>

    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" role="list">
      {
        maps.map((map) => (
          <li>
            <a href={`/mapas/${map.id}/`} class="panel block h-full transition hover:brightness-110">
              <img
                src={map.data.image}
                alt={map.data.namePt}
                width="300"
                height="300"
                loading="lazy"
                decoding="async"
                class="aspect-square w-full object-cover"
              />
              <div class="panel__body flex flex-col gap-1">
                <div class="flex items-center gap-2">
                  <img src={map.data.gameMode.image} alt={map.data.gameMode.name} width="18" height="18" />
                  <span class="text-xs font-bold" style={{ color: map.data.gameMode.color }}>
                    {map.data.gameMode.name}
                  </span>
                </div>
                <span class="font-bold text-white">{map.data.namePt}</span>
                <span class="text-xs text-white/50">{map.data.name}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
